  "title": "Add the 'proxy' parameter and deprecate 'proxies'.",
  "user": {
    "login": "karpetrosyan",
    "id": 92274156,
    "node_id": "U_kgDOBX_97A",
    "avatar_url": "https://avatars.githubusercontent.com/u/92274156?v=4",
