[
  {
    "sha": "74876c40efa3137aee8ebf5d53d9542d65a13381",
    "node_id": "C_kwDOAmN2vNoAKDc0ODc2YzQwZWZhMzEzN2FlZThlYmY1ZDUzZDk1NDJkNjVhMTMzODE",
    "commit": {
      "author": {
        "name": "Ronny Pfannschmidt",
        "email": "opensource@ronnypfannschmidt.de",
        "date": "2025-11-28T20:57:49Z"
      },
      "committer": {
        "name": "Ronny Pfannschmidt",
        "email": "opensource@ronnypfannschmidt.de",
        "date": "2026-05-27T07:05:59Z"
      },
      "message": "Fix varnames to handle Python 3.14 deferred annotations\n\nIn Python 3.14+, annotations are evaluated lazily per PEP 649/749.\nWhen inspect.signature() is called, it tries to resolve annotations\nby default, which fails if the annotation references an undefined type.\n\nAdd a version-gated _signature helper that uses\nannotation_format=annotationlib.Format.STRING on Python 3.14+ to\nprevent annotation resolution errors.\n\nFixes #629\n\n\ud83e\udd16 Generated with [Claude Code](https://claude.com/claude-code)\n\nCo-Authored-By: Claude <noreply@anthropic.com>",
      "tree": {
        "sha": "d269029e7e3e2b2ef35a0afe83bdb53e5eafa2f7",
        "url": "https://api.github.com/repos/pytest-dev/pluggy/git/trees/d269029e7e3e2b2ef35a0afe83bdb53e5eafa2f7"
