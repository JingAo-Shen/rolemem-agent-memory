[
  {
    "sha": "addd5c5699a04d07ae479438f33de7fb19b70632",
    "node_id": "C_kwDOBcnBg9oAKGFkZGQ1YzU2OTlhMDRkMDdhZTQ3OTQzOGYzM2RlN2ZiMTliNzA2MzI",
    "commit": {
      "author": {
        "name": "Pradyun Gedam",
        "email": "pradyunsg@users.noreply.github.com",
        "date": "2022-07-08T13:48:55Z"
      },
      "committer": {
        "name": "Pradyun Gedam",
        "email": "pradyunsg@users.noreply.github.com",
        "date": "2022-07-08T13:48:55Z"
      },
      "message": "Reorder `Specifier` regex groups to check wildcard matches early\n\nThis ensures that an `re.match` or `re.search` does not exclude the\nwildcard in cases where it would otherwise match. Without this\nreordering, a regex match of a wildcard specifier would only match the\nversion sections before it since both parts of the prior part of the\nunnamed group are optional, allowing the group to match an empty string\neven though it is optional as a whole.\n\nThis does not affect `Specifier` since the regex used by it gets a `$`\nadded to it, forcing the regular expression engine to backtrack in such\ncases. It does, however, affect `Requirement` since it is currently\nallowing these values through since they match the regex for\n`LegacySpecifier`.",
      "tree": {
        "sha": "dc08cd4bf07cfacab1a6efb15164016e3dde66bf",
        "url": "https://api.github.com/repos/pypa/packaging/git/trees/dc08cd4bf07cfacab1a6efb15164016e3dde66bf"
      },
      "url": "https://api.github.com/repos/pypa/packaging/git/commits/addd5c5699a04d07ae479438f33de7fb19b70632",
      "comment_count": 0,
      "verification": {
        "verified": true,
        "reason": "valid",
        "signature": "-----BEGIN PGP SIGNATURE-----\n\niQIzBAABCAAdFiEE4v76TKS90oFx2wDz/5lxDEMyJY4FAmLINi4ACgkQ/5lxDEMy\nJY5alw/8CAT1VANlduMGFd0BnUAUftKIQ2mIB0PvPzVtGIbEdo6pcWOFfKoS3oE8\n8VGzhTWfRFYI4z1fWGJ6ZJlWAKppEMQNta7Of3yYY7wHLhgrnTbOFMdIGzWx15z2\nHdFWsmxk0+fBQP7tAY8EbSVkJZjrZoHF6d06YpHotguIHgeSnyhp8qivI/RgBKGT\ndiUDBxKhk+lP/HT428LyqCbS06jDu4u8BCmtJr8wu52vUnZlX76inYQOeE75KSdK\nJfYjpRYdx633KOsHL3pMi53H+FHQm7BaWrMPa4cehgkvL8Aj5w2wt/2n2aAKBpj4\nUZE8yogdeQ7thIesT3cl0/ybt3W7CJlsCLZaJGtC5xBHuqIhBdeskWItzpDe1ivF\n7MU0cRISMSyxihu04eUwub6fqBKpRQdGCoglPtEdjlhdXcK9ctVvM8S09tA5CcbI\nzDMLUjGCSkZWX7azGwWCGL+cxRLfP5bGxJny2KN4P9X3V4yUHgglTaImblcctaGN\n6zxX+z3wdObRzo1IAb9bz+R5VFXO2LUj+1DVtpRf+paSNgySulOqLSHhCqg2uNX1\nKwkcviWOuUWAIg63KLUdHGaJgSiB6IQ2Rkg8qXbQaRkabzIL8c12xi2OXPNz7ORB\n0yyUiQMPHYO+4bX7ATeRaoDpykU1ogVEP9xPGP+DKQ5m0j8uCDo=\n=Pb1N\n-----END PGP SIGNATURE-----",
        "payload": "tree dc08cd4bf07cfacab1a6efb15164016e3dde66bf\nparent 4f42225e91a0be634625c09e84dd29ea82b85e27\nauthor Pradyun Gedam <pradyunsg@users.noreply.github.com> 1657288135 +0100\ncommitter Pradyun Gedam <pradyunsg@users.noreply.github.com> 1657288135 +0100\n\nReorder `Specifier` regex groups to check wildcard matches early\n\nThis ensures that an `re.match` or `re.search` does not exclude the\nwildcard in cases where it would otherwise match. Without this\nreordering, a regex match of a wildcard specifier would only match the\nversion sections before it since both parts of the prior part of the\nunnamed group are optional, allowing the group to match an empty string\neven though it is optional as a whole.\n\nThis does not affect `Specifier` since the regex used by it gets a `$`\nadded to it, forcing the regular expression engine to backtrack in such\ncases. It does, however, affect `Requirement` since it is currently\nallowing these values through since they match the regex for\n`LegacySpecifier`.\n",
        "verified_at": "2024-11-07T15:37:01Z"
      }
    },
