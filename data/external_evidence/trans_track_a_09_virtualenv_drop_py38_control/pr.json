  "number": 3170,
  "state": "closed",
  "locked": false,
  "title": "\u2728 feat: drop Python 3.8 support",
  "user": {
    "login": "gaborbernat",
    "id": 690238,
    "node_id": "MDQ6VXNlcjY5MDIzOA==",
    "avatar_url": "https://avatars.githubusercontent.com/u/690238?v=4",
    "gravatar_id": "",
